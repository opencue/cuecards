{
  "name": "cue-ai",
  "version": "0.10.0",
  "description": "Per-project profile manager for Claude Code, Codex, and 8 other AI coding agents — scopes which skills and MCP servers load, per directory.",
  "type": "module",
  "bin": {
    "cue": "bin/cue.mjs",
    "cue-learnings": "bin/cue-learnings"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "cue": "bun src/index.ts",
    "test": "bun test",
    "eval:profile-suggestions": "bun scripts/evaluate-profile-suggestions.ts",
    "profiles:aas": "bun scripts/generate-aas-profiles.ts",
    "test:critical:coverage": "bun test src/lib/profile-loader.test.ts src/lib/cwd-resolver.test.ts src/lib/runtime-materializer.test.ts src/commands/launch.test.ts --coverage --coverage-reporter=lcov --coverage-dir=coverage/critical --timeout 30000 && bun scripts/check-critical-coverage.ts",
    "lint:skills:baseline": "bun scripts/check-skill-lint-baseline.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src web/src scripts",
    "build": "bun build src/index.ts --no-bundle",
    "build:bundle": "bun build src/index.ts --target=node --outfile=dist/cue.js",
    "prepack": "bash scripts/prepack-check.sh && bun run build:bundle",
    "postinstall": "echo '' && echo '  ✅ cue installed.' && echo '  Next: run `cue setup`  — installs the shim, scans this project, pins a profile' && echo '  Docs: https://github.com/opencue/cuecards' && echo ''"
  },
  "keywords": [
    "claude-code",
    "codex",
    "agent",
    "profile",
    "profile-manager",
    "skills",
    "claude-skill",
    "agent-skill",
    "mcp",
    "mcp-server",
    "ai",
    "ai-agents",
    "ai-coding",
    "anthropic",
    "claude",
    "cli",
    "developer-tools"
  ],
  "author": "NagyVikt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opencue/cuecards.git"
  },
  "homepage": "https://github.com/opencue/cuecards",
  "bugs": {
    "url": "https://github.com/opencue/cuecards/issues"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "profiles/*/profile.yaml",
    "profiles/*/logo.png",
    "profiles/*/README.md",
    "profiles/_types.ts",
    "profiles/schema.json",
    "profiles/SCHEMA.md",
    "profiles/README.md",
    "resources/skills/skills/",
    "resources/skills/README.md",
    "resources/mcps/configs/",
    "resources/mcps/README.md",
    "resources/icons/",
    "plugins/",
    "install.sh",
    "get.sh",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@clack/core": "^1.3.1",
    "@clack/prompts": "^1.4.0",
    "ajv": "^8.17.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
