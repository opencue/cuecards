# Dependencies
node_modules/
bun.lock.bak

# Build artifact — node bundle, regenerated by `bun run build:bundle` / prepack
dist/

# Test coverage and local backup files are generated, never source.
coverage/
*.bak-*
.codegraph/*.lock

# Profile runtime / cache
profiles/_active
profiles/_cache/
# Test-output profile written by src/lib/dashboard-merge.test.ts (merge/save).
# Self-healed by the test's beforeEach/afterAll, but ignore it so an
# interrupted run can never leave a committable artifact in profiles/.
profiles/dash-merge-test/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Cloned marketplace (not part of this repo)
claude-plugins-official/

# Generated runtime (lives at ~/.config/cue/ but excluded if symlinked in for inspection)
.cue-hash

# Local git worktrees (scratch checkouts with their own .git; committing them as
# bare gitlinks with no .gitmodules URL breaks `git submodule update` in CI).
.claude/worktrees/

# OMX / OMC agent state (per-session traces + mission state, not source-controlled)
.omx/
.omc/
andrej-karpathy-skills/
agentshield/
awesome-clis/

# Locally-cloned third-party skills (have their own .git/ — keep out of cue's tree)
.claude/skills/hirelens-showcase/
.claude/skills/jdfit/
.claude/skills/job-hunter/

# Third-party repos cloned for study (have their own .git/ — keep out of cue's tree)
vendor/
.gstack/
vibecode-pro-max-kit/

# user-local skill clones (nested .git) — force-added as stray gitlinks with no
# .gitmodules URL, which broke CI submodule checkout on every job (PR #49/#51).
# jdfit + job-hunter also live canonically under resources/skills/skills/career/.
.agents/skills/hirelens-showcase/
.agents/skills/jdfit/
.agents/skills/job-hunter/
# Local source checkout used by `bun run profiles:aas`; generated profiles pin
# the remote Git revision, so the 390 MB catalog clone is build input, not repo content.
/resources/agentic-awesome-skills/
/resources/ai-memory/

# multiagent-safety:START
.omx/
.omc/
.codex/
!.vscode/
.vscode/*
!.vscode/settings.json
scripts/guardex-docker-loader.sh
scripts/guardex-env.sh
.githooks
oh-my-codex/
.omx/state/agent-file-locks.json
# multiagent-safety:END
